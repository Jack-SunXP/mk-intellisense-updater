{
    "compilerOptions": {
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "lib": [
            "ES2022"
        ],
        "allowJs": true,
        "checkJs": true,
        "noEmit": true,
        "strict": false,
        "noImplicitAny": true,
        "noImplicitThis": true,
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "types": [
            "vscode",
            "node"
        ]
    },
    "include": [
        "extension.js",
        "src/**/*.js",
        "test/**/*.js"
    ],
    "exclude": [
        "node_modules",
        ".vscode"
    ]
}
