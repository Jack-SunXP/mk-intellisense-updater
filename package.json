{
    "name": "mk-intellisense-updater",
    "displayName": "%ext.displayName%",
    "description": "%ext.description%",
    "version": "0.2.1",
    "publisher": "JackSun",
    "author": "Jack Sun",
    "license": "SEE LICENSE IN LICENSE.md",
    "repository": {
        "type": "git",
        "url": "https://github.com/Jack-SunXP/mk-intellisense-updater"
    },
    "bugs": {
        "url": "https://github.com/Jack-SunXP/mk-intellisense-updater/issues"
    },
    "icon": "assets/icon.png",
    "engines": {
        "vscode": "^1.80.0"
    },
    "categories": [
        "Programming Languages"
    ],
    "keywords": [
        "makefile",
        "include",
        "include-path",
        "c++",
        "c",
        "static-analysis"
    ],
    "main": "./extension.js",
    "contributes": {
        "commands": [
            {
                "command": "mkintellisense.updateIntelliSense",
                "title": "%command.updateFromThis.title%"
            },
            {
                "command": "mkintellisense.updateIntelliSensePick",
                "title": "%command.pickMk.title%"
            }
        ],
        "menus": {
            "explorer/context": [
                {
                    "when": "resourceFilename =~ /.*\\.mk$/",
                    "command": "mkintellisense.updateIntelliSense",
                    "group": "navigation@1"
                }
            ],
            "commandPalette": [
                {
                    "command": "mkintellisense.updateIntelliSense",
                    "when": "false"
                }
            ]
        },
        "configuration": {
            "title": "%config.title%",
            "properties": {
                "mkintellisense.libraryMkSearchGlobs": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "default": [
                        "**/*.mk"
                    ],
                    "scope": "resource",
                    "description": "%config.libraryMkSearchGlobs.description%"
                },
                "mkintellisense.lowConfidenceThreshold": {
                    "type": "number",
                    "default": 0.7,
                    "minimum": 0,
                    "maximum": 1,
                    "scope": "resource",
                    "description": "%config.lowConfidenceThreshold.description%"
                },
                "mkintellisense.lowConfidenceMode": {
                    "type": "string",
                    "default": "discard",
                    "enum": [
                        "discard",
                        "include_with_warning"
                    ],
                    "enumDescriptions": [
                        "%config.lowConfidenceMode.enum.discard%",
                        "%config.lowConfidenceMode.enum.includeWithWarning%"
                    ],
                    "scope": "resource",
                    "description": "%config.lowConfidenceMode.description%"
                },
                "mkintellisense.directoryRatioThreshold": {
                    "type": "number",
                    "default": 0.9,
                    "minimum": 0.5,
                    "maximum": 1,
                    "scope": "resource",
                    "description": "%config.directoryRatioThreshold.description%"
                },
                "mkintellisense.minTokensPerVariable": {
                    "type": "number",
                    "default": 2,
                    "minimum": 1,
                    "maximum": 10,
                    "scope": "resource",
                    "description": "%config.minTokensPerVariable.description%"
                },
                "mkintellisense.includeVariableSelection": {
                    "type": "string",
                    "default": "inc-only",
                    "enum": [
                        "inc-only",
                        "prefer",
                        "all"
                    ],
                    "enumDescriptions": [
                        "%config.includeVariableSelection.enum.incOnly%",
                        "%config.includeVariableSelection.enum.prefer%",
                        "%config.includeVariableSelection.enum.all%"
                    ],
                    "scope": "resource",
                    "description": "%config.includeVariableSelection.description%"
                }
            }
        }
    },
    "devDependencies": {
        "@types/node": "^20.19.43",
        "@types/vscode": "^1.80.0"
    }
}
